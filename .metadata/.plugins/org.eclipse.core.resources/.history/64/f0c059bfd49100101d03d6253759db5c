package org.unibl.etf.service;

import java.util.List;
import org.unibl.etf.dto.LoginDTO;
import org.unibl.etf.dto.RegistrationDTO;
import org.unibl.etf.model.Client;
import org.unibl.etf.model.ClientStatus;
import org.unibl.etf.model.Invoice;
import org.unibl.etf.model.Vehicle;
import org.unibl.etf.repository.*;

public class ClinetService {
	
	private final ClientRepository clientRepository;

	public ClinetService() {
		clientRepository = ClientRepository.getInstance();
	}
	
    public List<Client> getAllClients() {
    	return clientRepository.getClients();
    }
    
    public Client findByUsername(String username) {
        return clientRepository.getClients()
                .stream()
                .filter(c -> c.getUsername().equals(username))
                .findFirst()
                .orElse(null);
    }
    
    // validacija logina klijenta
    public boolean authenticateLogin(LoginDTO loginDto) {
    	Client client = findByUsername(loginDto.getUsername());
    	if(client != null && client.getStatus() == ClientStatus.ACTIVE && client.getPassword().equals(loginDto.getPassword()))
    		return true;
    	return false;
    }
    
    // prilikom registracije pravimo novog klijenta 
    public boolean createClient(RegistrationDTO registrationDto) {
    	String firstName = registrationDto.getFirstName();
    	String lastName = registrationDto.getLastName();
    	Vehicle vehicle = registrationDto.getVehicle();
    	String address = registrationDto.getAddress();
    	String phone = registrationDto.getPhoneNumber();
    	String email = registrationDto.getEmail();
    	String username = registrationDto.getUsername();
    	String password = registrationDto.getPassword();
    	return addClient(new Client(firstName, lastName, vehicle, address, phone, email, username, password, ClientStatus.PENDING));
    }

    public boolean removeClient(String username) {
        if (findByUsername(username) != null) {
        	return deleteClient(username);
        }
        return false;
    }
    
    public boolean updateClient(String username, Client updatedClient) {
        Client existing = findByUsername(username);
        if (existing == null) 
        	return false;

        int index = clientRepository.getClients().indexOf(existing);
        clientRepository.getClients().set(index, updatedClient);
        clientRepository.save();
        return true;
    }

    public boolean approveClientAccount(String username) {
    	 Client client = findByUsername(username);
    	if(client != null) {
    		client.setStatus(ClientStatus.ACTIVE);
    		return updateClient(client.getUsername(), client);
    	}
    	return false;
    }
    
    public boolean blockClientAccount(Client client) {
    	if(client != null) {
    		client.setStatus(ClientStatus.BLOCKED);
    		return updateClient(client.getUsername(), client);
    	}
    	return  false;
    }
    
    // TODO
    public boolean sendInvoice(Client client, Invoice invoice) {
    	return false;
    }
    
    private boolean addClient(Client client) {
    	client.setStatus(ClientStatus.PENDING);
        boolean result = clientRepository.getClients().add(client);
        clientRepository.save();
        return result;
    }

    private boolean deleteClient(String username) {
    	boolean result = clientRepository.getClients().removeIf(c -> c.getUsername().equals(username));
    	clientRepository.save();
        return result;
    }
}
