package org.unibl.etf.central.server.service;

import static org.unibl.etf.logger.MyLogger.logger;

import java.util.List;
import java.util.logging.Level;

import org.unibl.etf.central.server.repository.SupplierRepository;
import org.unibl.etf.central.server.supplier.SupplierClient;
import org.unibl.etf.dto.OrderRequestDTO;
import org.unibl.etf.model.Item;
import org.unibl.etf.model.Order;
import org.unibl.etf.model.OrderStatus;
import org.unibl.etf.model.Supplier;
import org.unibl.etf.model.VehiclePart;

public class SupplierService {

	private final SupplierRepository supplierRepository;
	private OrderRequestService orderService;
	private SupplierClient client = new SupplierClient();
	
	public SupplierService() {
		supplierRepository = SupplierRepository.getInstance();
		this.orderService = new OrderRequestService();
	}
	
	public List<Supplier> getAllSuplliers(){
		return supplierRepository.getSuppliers();
	}
	
	public Supplier findByName(String name) {
		return supplierRepository.getSuppliers().stream()
				.filter(s -> s.getName().equals(name))
				.findFirst()
				.orElse(null);
	}
	
	public List<Item> getSuplierItems(String name) {
		Supplier supplier = findByName(name);
		if(supplier != null) {
			// Komunikacija sa dobavljacem preko soketa
			try {
				return client.getOffer(supplier);
			} catch (Exception e) {
				e.printStackTrace();
				logger.log(Level.WARNING, "Exception: ", e);
			}
		}
		return null;
	}
	
	public Order getOrder(String name, int id) {
		Supplier supplier = findByName(name);
		try {
			Order order = client.getOrderStatus(supplier, id);
			if(order.getStatus() == OrderStatus.APPROVED) {
				orderService.deleteOrderRequest(order.getId());
				VehiclePartService partService = new VehiclePartService();
				String partCode = order.getItem().getCode();
				String partName = order.getItem().getTitle();
				double price = order.getItem().getPrice();
				int availableQuantity = order.getQuantity();
				partService.createPart(new VehiclePart(partCode, partName, "unknown", price, availableQuantity, ""));
			}
			else if(order.getStatus() == OrderStatus.REJECTED) {
				orderService.deleteOrderRequest(order.getId());
			}
			return order;
		} catch (Exception e) {
			e.printStackTrace();
			logger.log(Level.WARNING, "Exception: ", e);
		}
		return null;
	}
	
	public int sendOrder(String name, Item item, int quantity) {
		Supplier supplier = findByName(name);
		try {
			int result = client.sendOrder(supplier, item, quantity); 
			orderService.addOrderRequest(new OrderRequestDTO(result, item, supplier));
			return result;
		}catch (Exception e) {
			e.printStackTrace();
			logger.log(Level.WARNING, "Exception: ", e);
		}
		return -1;
	}
	
}
