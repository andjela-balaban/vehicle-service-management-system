package application;

import java.io.IOException;

import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.stage.Stage;

public class MainSceneController {
	@FXML
	private Button buttonItems;
	@FXML
	private Button buttonOrders;
	
	
	@FXML
    private void switchToItemsScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneItems.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) buttonItems.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Artikli");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
	
	@FXML
    private void switchToManageAppointments() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneManageAppointments.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) buttonManageAppointments.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Upravljanje terminima");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
