package org.unibl.etf.service.rest;

import org.unibl.etf.model.VehiclePart;
import org.unibl.etf.properties.ConfigManager;

import javax.ws.rs.client.Client;
import javax.ws.rs.client.ClientBuilder;
import javax.ws.rs.client.Entity;
import javax.ws.rs.client.WebTarget;
import javax.ws.rs.core.MediaType;
import javax.ws.rs.core.Response;
import java.util.List;

public class PartRESTController {

    private static final String BASE_URL = ConfigManager.PARTS_URL;

    public static List<VehiclePart> getAllParts() {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL);

        Response response = target.request(MediaType.APPLICATION_JSON).get();

        if (response.getStatus() == 200) {
            List<VehiclePart> parts = response.readEntity(new javax.ws.rs.core.GenericType<List<VehiclePart>>() {});
            return parts;
        }
        return null;
    }

    public static boolean createPart(VehiclePart part) {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL);

        Response response = target.request(MediaType.APPLICATION_JSON)
                .post(Entity.entity(part, MediaType.APPLICATION_JSON));

        return response.getStatus() == 201;
    }

    public static boolean updatePart(String code, VehiclePart part) {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL + "/" + code);

        Response response = target.request(MediaType.APPLICATION_JSON)
                .put(Entity.entity(part, MediaType.APPLICATION_JSON));

        return response.getStatus() == 200;
    }

    public static boolean deletePart(String code) {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL + "/" + code);

        Response response = target.request(MediaType.APPLICATION_JSON).delete();

        return response.getStatus() == 200;
    }

    public static VehiclePart getPartByCode(String code) {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL + "/" + code);

        Response response = target.request(MediaType.APPLICATION_JSON).get();

        if (response.getStatus() == 200) {
            VehiclePart part = response.readEntity(VehiclePart.class);
            client.close();
            return part;
        }

        client.close();
        return null;
    }
}

