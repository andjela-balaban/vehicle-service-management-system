package org.unibl.etf.supplier.repository;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.net.URL;
import java.util.*;
import java.util.logging.Level;

import org.unibl.etf.model.*;
import org.unibl.etf.properties.ConfigManager;
import org.unibl.etf.supplier.parser.ItemScraper;

public class ItemRepository {
	private static List<Item> items = new ArrayList<>();
	private static ItemRepository instance = null;
	private static String LINKS_PATH = ConfigManager.LINKS_PATH;
	private static String ALT_PATH = ConfigManager.ALT_PATH;
	private static List<Item> updatedItems = new ArrayList<>();
	private static String UPDATE_LINK_PATH = ConfigManager.UPDATE_LINK_PATH;
	private static String UPDATE_ALT_PATH = ConfigManager.UPDATE_ALT_PATH;
	
	
	private ItemRepository() {
		super();
		loadItems(LINKS_PATH, items);
		if(items.isEmpty())
			alternateItemsLoad(ALT_PATH, items);
	}
	
	private static void loadItems(String fileName, List<Item> items) {
		try(BufferedReader in = new BufferedReader(new FileReader(fileName))){
			 String line;
			 while((line = in.readLine()) != null) {
				 try {
					 // Ucitavanje proizvoda pomocu parsera 
					 Item item = ItemScraper.scrape(new URL(line));
					 if(item != null)
						 items.add(item);
				} catch (Exception e) {
					e.printStackTrace();
					logger.log(Level.WARNING, "Exception: ", e);
				}
			 }
		} catch(IOException e) {
			e.printStackTrace();
			logger.log(Level.WARNING, "Exception: ", e);
		}
	}
	
	public static ItemRepository getInstance() {
		 if(instance == null) 
			 instance = new ItemRepository();
		 return instance; 
	}
	
	public List<Item> getItems(){
		return items;
	}
	
	private static void alternateItemsLoad(String fileName, List<Item> items) {
		try(BufferedReader in = new BufferedReader(new FileReader(fileName))){
			 String line;
			 while((line = in.readLine()) != null) {
				 String parts[] = line.split("#");
				 if(parts.length == 4) {
					 String code = parts[0];
					 String title = parts[1];
					 double price = Double.parseDouble(parts[2]);
					 URL imgURL = new URL(parts[3]);
					 items.add(new Item(code, title, price, imgURL));
				 }
			 }
		} catch(IOException e) {
			e.printStackTrace();
			logger.log(Level.WARNING, "Exception: ", e);
		}
	}
	
	public List<Item> getUpdatedOffer(){
		loadItems(UPDATE_LINK_PATH, updatedItems);
		if(updatedItems.isEmpty())
			alternateItemsLoad(UPDATE_ALT_PATH, updatedItems);
		return updatedItems;
	}
}
