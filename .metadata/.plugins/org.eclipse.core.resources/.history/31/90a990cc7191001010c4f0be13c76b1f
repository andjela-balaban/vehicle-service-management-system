package org.unibl.etf.service;

import java.util.List;

import org.unibl.etf.model.*;
import org.unibl.etf.repository.*;

public class AppointmentService {
	private final AppointmentRepository appointmentRepository = AppointmentRepository.getInstance();

	
	
	private boolean add(Appointment client) {
        boolean result = clientRepository.getClients().add(client);
        clientRepository.save();
        return result;
    }

    private boolean delete(String username) {
    	boolean result = clientRepository.getClients().removeIf(c -> c.getUsername().equals(username));
    	clientRepository.save();
        return result;
    }
    
    public List<Appointment> findAll() {
        return clientRepository.getClients();
    }
    
    public Client findByUsername(String username) {
        return clientRepository.getClients()
                .stream()
                .filter(c -> c.getUsername().equals(username))
                .findFirst()
                .orElse(null);
    }
    
    public List<Appointment> getAllAppointments() {
        return findAll();
    }
}	
