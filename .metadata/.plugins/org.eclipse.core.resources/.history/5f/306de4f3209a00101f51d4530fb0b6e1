package org.unibl.etf.supplierapp.server;

import org.unibl.etf.model.*;

public class ClientMain {
    public static void main(String[] args) {
        try {
            SupplierGUIClient client = new SupplierGUIClient("localhost");

            // Test login
            boolean ok = client.login("supplier1");
            System.out.println("Login uspješan: " + ok);

            // Test lista artikala
            System.out.println("Artikli: " + client.getItems());

            // Test dodavanje artikla
            Item novi = new Item();
            novi.setTitle("Filter ulja");
            novi.setPrice(25.0);
            novi.setCode("1");;
            boolean dodat = client.addItem(novi);
            System.out.println("Artikal dodat: " + dodat);

            // Test preuzimanja narudžbe (iz reda MQ)
            Order o = client.getNextOrder();
            if (o != null) {
                System.out.println("Preuzeta narudžba: " + o);
                boolean approved = client.approveOrder(o.getId());
                System.out.println("Odobreno: " + approved);
            } else {
                System.out.println("Nema narudžbi u redu.");
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
    }
}
