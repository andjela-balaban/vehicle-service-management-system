package org.unibl.etf.service.rest;

import java.util.List;

import javax.ws.rs.client.Client;
import javax.ws.rs.client.ClientBuilder;
import javax.ws.rs.client.Entity;
import javax.ws.rs.client.WebTarget;
import javax.ws.rs.core.MediaType;
import javax.ws.rs.core.Response;
import org.unibl.etf.model.Appointment;
import org.unibl.etf.properties.ConfigManager;

public class AppintmentRESTController {

	private static String BASE_URL = ConfigManager.APPOINTMENTS_URL;
	
	public static List<Appointment> getAllAppointments(){
		Client client = ClientBuilder.newClient();
		WebTarget target = client.target(BASE_URL);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			List<Appointment> appointments = response.readEntity(
					new javax.ws.rs.core.GenericType<List<Appointment>>() {});
			return appointments;
		}
		else {
			System.out.println("Error: " + response.getStatus());
            return null;
		}	
	}
	
	public static List<Appointment> getAllClientAppointments(int clientId){
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/client/" + clientId;
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			List<Appointment> appointments = response.readEntity(
					new javax.ws.rs.core.GenericType<List<Appointment>>() {});
			return appointments;
		}
		else {
			System.out.println("Error: " + response.getStatus());
            return null;
		}	
	}
	
	
	public static boolean confirmAppointment(int id, String comment) {
	    Client client = ClientBuilder.newClient();
	    String url = BASE_URL + "/" + id + "/complete";
	    WebTarget target = client.target(url);

	    Response response = target.queryParam("comment", comment)
	                              .request(MediaType.APPLICATION_JSON)
	                              .put(Entity.json(""));
	    
	    if(response.getStatus() == 200) {
	    	return true;
	    }
	    return false;
	}

	public static boolean rejectAppointment(int id, String comment) {
	    Client client = ClientBuilder.newClient();
	    String url = BASE_URL + "/" + id + "/cancel";
	    WebTarget target = client.target(url);

	    Response response = target.queryParam("comment", comment)
	                              .request(MediaType.APPLICATION_JSON)
	                              .put(Entity.json(""));
	    if(response.getStatus() == 200) {
	    	client.close();
	    	return true;
	    }
	    client.close();
	    return false;
	}

	public static Appointment updateAppointment(Appointment appointment) {
	    Client client = ClientBuilder.newClient();
	    String url = BASE_URL + "/" + appointment.getId();
	    WebTarget target = client.target(url);

	    Response response = target.request(MediaType.APPLICATION_JSON)
	            .put(Entity.entity(appointment, MediaType.APPLICATION_JSON));

	    if(response.getStatus() == 200) {
	    	Appointment appointmentRes = response.readEntity(Appointment.class);
	    	client.close();
	    	return appointmentRes;
	    }
	    client.close();
	    return null;
	}

	
}
