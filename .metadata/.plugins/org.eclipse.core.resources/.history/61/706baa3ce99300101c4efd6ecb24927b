public class ChatServer {
    private static ChatServer instance = null;
    private static int PORT = ConfigManager.CHAT_PORT; // TCP port za unicast
    private static int UDP_PORT = 6000; // UDP port za multicast
    private static String KEY_STORE_PATH = ConfigManager.KEY_STORE_PATH;
    private static String KEY_STORE_PASSWORD = ConfigManager.KEY_STORE_PASSWORD;

    private static Map<Integer, ClientHandler> activeClients = new ConcurrentHashMap<>();
    private static Map<Integer, InetSocketAddress> udpClients = new ConcurrentHashMap<>();
    private static DatagramSocket udpSocket;

    private ChatServer() {}

    public static void main(String[] args) throws IOException {
        System.setProperty("javax.net.ssl.keyStore", KEY_STORE_PATH);
        System.setProperty("javax.net.ssl.keyStorePassword", KEY_STORE_PASSWORD);

        // pokretanje UDP socketa
        udpSocket = new DatagramSocket();

        // TCP server za unicast
        SSLServerSocketFactory ssf = (SSLServerSocketFactory) SSLServerSocketFactory.getDefault();
        SSLServerSocket ss = (SSLServerSocket) ssf.createServerSocket(PORT);
        System.out.println("ChatServer started...");

        while (true) {
            SSLSocket s = (SSLSocket) ss.accept();
            new ClientHandler(s).start();
        }
    }

    public static synchronized ChatServer getInstance() {
        if (instance == null) instance = new ChatServer();
        return instance;
    }

    public static void addClient(int userId, ClientHandler handler, InetSocketAddress udpAddress) {
        activeClients.put(userId, handler);
        udpClients.put(userId, udpAddress);
        System.out.println("Client " + userId + " connected.");
    }

    public static void removeClient(int userId) {
        activeClients.remove(userId);
        udpClients.remove(userId);
        System.out.println("Client " + userId + " disconnected.");
    }

    public static void routeMessage(ChatMessage msg) {
        if (msg.getType() == MessageType.UNICAST) {
            int receiverId = Integer.parseInt(msg.getReceiverId());
            ClientHandler handler = activeClients.get(receiverId);
            if (handler != null) {
                handler.sendMessage(msg);
            }
        } else if (msg.getType() == MessageType.MULTICAST) {
            // šaljemo UDP datagram svima
            byte[] data = msg.getSenderId() + ": " + msg.getContent() .getBytes();
            udpClients.values().forEach(addr -> {
                try {
                    DatagramPacket packet = new DatagramPacket(data, data.length, addr.getAddress(), addr.getPort());
                    udpSocket.send(packet);
                } catch (IOException e) {
                    e.printStackTrace();
                }
            });
        }
    }
}

