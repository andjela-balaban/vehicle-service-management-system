package org.unibl.etf.chat.server;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.*;
import java.net.*;
import java.util.logging.Level;

import org.unibl.etf.dto.*;

public class ClientHandlerThread extends Thread {
    private Socket socket;
    private ObjectInputStream in;
    private ObjectOutputStream out;
    private int clientId;
    private InetAddress clientAddress;
    private int clientUdpPort;

    public ClientHandlerThread(Socket socket) {
        this.socket = socket;
        this.clientAddress = socket.getInetAddress();
        try {
            this.out = new ObjectOutputStream(socket.getOutputStream());
            this.in = new ObjectInputStream(socket.getInputStream());
        } catch(IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

    @Override
    public void run() {
        try {
            String id = (String) in.readObject();
            this.clientId = Integer.parseInt(id);

            String udpPortMsg = (String) in.readObject(); // druga poruka - udp port klijenta
            if (udpPortMsg.startsWith("UDP_PORT:")) {
                this.clientUdpPort = Integer.parseInt(udpPortMsg.split(":")[1]);
            } 
            else {
                this.clientUdpPort = 0;
            }
            ChatServer.addClient(clientId, this);
            ChatMessage msg;
            while ((msg = (ChatMessage) in.readObject()) != null) {
                ChatServer.routeMessage(msg);
            }

        } catch (IOException | ClassNotFoundException e) {
            System.out.println("Connection with " + clientId + " lost.");
        } finally {
            ChatServer.removeClient(clientId);
            try { 
            	socket.close(); 
            } catch (IOException e) { 
            	e.printStackTrace(); 
            }
        }
    }

    public void sendMessage(ChatMessage msg) {
        try {
            out.writeObject(msg);
            out.flush();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public void sendUDPMessage(ChatMessage msg) {
        try(DatagramSocket udpSocket = new DatagramSocket()) {
            byte[] data = msg.toString().getBytes();
            DatagramPacket packet = new DatagramPacket(data, data.length, clientAddress, clientUdpPort);
            udpSocket.send(packet);
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public int getClientId() {
        return clientId;
    }
}

