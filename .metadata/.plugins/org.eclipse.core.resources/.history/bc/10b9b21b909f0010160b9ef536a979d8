package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import java.util.List;
import java.util.logging.Level;

import org.unibl.etf.model.Supplier;
import org.unibl.etf.service.rest.SupplierRESTController;
import javafx.collections.FXCollections;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Alert;
import javafx.scene.control.Button;
import javafx.scene.control.ChoiceBox;
import javafx.stage.Stage;


public class ChooseSupplierSceneController {
    @FXML 
    private Button confirmButton;
    @FXML 
    private Button cancelButton;
    @FXML
    private ChoiceBox<Supplier> suppliersChoiceBox;

    private Supplier selectedSupplier;
    
    @FXML
    private void initialize() {
        List<Supplier> suppliers = SupplierRESTController.getAllSuppliers();
        if (suppliers != null) {
        	suppliersChoiceBox.setItems(FXCollections.observableArrayList(suppliers));
        }
    }

    @FXML
    private void closeDialog() {
        Stage stage = (Stage) cancelButton.getScene().getWindow();
        stage.close();
    }    
    
    @FXML
    private void switchToOrders() {
        Supplier supplier = suppliersChoiceBox.getValue();
        if (supplier == null) {
            Alert alert = new Alert(Alert.AlertType.ERROR, "You must choose a supplier!");
            alert.showAndWait();
            return;
        }

        this.selectedSupplier = supplier;
        
        Stage dialogStage = (Stage) confirmButton.getScene().getWindow();
        Stage mainStage = (Stage) dialogStage.getOwner();
        dialogStage.close();

        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneOrders.fxml"));
            Parent root = loader.load();

            OrdersSceneController ordersController = loader.getController();
            ordersController.setSupplier(selectedSupplier);

            Scene scene = new Scene(root);
            mainStage.setScene(scene);
            mainStage.setTitle("Naručivanje dijelova od dobavljača");
            mainStage.show();

        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

}
