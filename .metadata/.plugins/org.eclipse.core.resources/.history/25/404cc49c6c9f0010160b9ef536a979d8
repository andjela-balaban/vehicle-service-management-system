package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.stage.Stage;
import java.time.LocalDate;
import java.time.LocalTime;
import java.util.logging.Level;

import org.unibl.etf.client.rest.MakeAppintmentRESTController;
import org.unibl.etf.session.UserSession;
import org.unibl.etf.dto.AppointmentDTO;
import org.unibl.etf.model.TypeOfService;
import javafx.scene.control.*;
import javafx.util.StringConverter;

public class MakeAppintmentController {
	@FXML
	private Button back;
	@FXML
    private DatePicker datePicker;
    @FXML
    private Spinner<Integer> hourSpinner;
    @FXML
    private Spinner<Integer> minuteSpinner;
    @FXML
    private ChoiceBox<String> serviceChoiceBox;
    @FXML
    private Button confirmButton;
    @FXML
    private Button cancelButton;
    
	@FXML
    private void switchToMainScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneMain.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) back.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Main screen");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
	
	
	@FXML
    public void initialize() {
        // Spinner for hours (0–23)
        hourSpinner.setValueFactory(new SpinnerValueFactory.IntegerSpinnerValueFactory(0, 23, 12));
        hourSpinner.setEditable(true);
        hourSpinner.getValueFactory().setConverter(twoDigitConverter());

        // Minute spinner (0–59)
        minuteSpinner.setValueFactory(new SpinnerValueFactory.IntegerSpinnerValueFactory(0, 59, 0, 5)); // step 5 min
        minuteSpinner.setEditable(true);
        minuteSpinner.getValueFactory().setConverter(twoDigitConverter());

        // ChoiceBox for service type
        serviceChoiceBox.getItems().addAll("REGULAR_SERVICE", "REPAIR");
    }
	
	private StringConverter<Integer> twoDigitConverter() {
        return new StringConverter<Integer>() {
            @Override
            public String toString(Integer value) {
                return String.format("%02d", value);
            }

            @Override
            public Integer fromString(String string) {
                return Integer.parseInt(string);
            }
        };
    }
	
	
	@FXML
    private void handleConfirm() {
        LocalDate date = datePicker.getValue();
        Integer hour = hourSpinner.getValue();
        Integer minute = minuteSpinner.getValue();
        String serviceType = serviceChoiceBox.getValue();

        if (date == null || hour == null || minute == null || serviceType == null) {
            showAlert(Alert.AlertType.ERROR, "Error", "Please fill in all the details.");
            return;
        }

        LocalDate datePicked = datePicker.getValue();
        Integer hourPicked = hourSpinner.getValue();
        Integer minutePicked = minuteSpinner.getValue();
        TypeOfService serviceTypeEnum = TypeOfService.valueOf(serviceChoiceBox.getValue());

        AppointmentDTO dto = new AppointmentDTO();
        dto.setClientId(UserSession.getInstance().getClientId());
        dto.setServiceType(serviceTypeEnum);
        dto.setDate(datePicked);
        dto.setTime(LocalTime.of(hourPicked, minutePicked));

        
        boolean success = MakeAppintmentRESTController.bookAppointmentRequest(dto);
        if (success) {
            showAlert(Alert.AlertType.INFORMATION, "Success", "The appointment has been successfully scheduled!");
        } else {
            showAlert(Alert.AlertType.ERROR, "Error", "Termin nije dostupan. Pokušajte drugi.");
        }
    }
	
	@FXML
    private void handleCancel() {
        datePicker.setValue(null);
        hourSpinner.getValueFactory().setValue(12);
        minuteSpinner.getValueFactory().setValue(0);
        serviceChoiceBox.setValue(null);
    }

    private void showAlert(Alert.AlertType type, String title, String message) {
        Alert alert = new Alert(type);
        alert.setTitle(title);
        alert.setHeaderText(null);
        alert.setContentText(message);
        alert.showAndWait();
    }
	
}
