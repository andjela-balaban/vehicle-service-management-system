package org.unibl.etf.supplier.parser;

import java.io.*;
import java.net.*;
import org.unibl.etf.model.*;
import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;


public class ItemScraper {
    
    public Item scrape(URL url) throws IOException {
        String code = null;
        String name = null;
        String price = null;
        String imageUrl = null;
        
        do {
            
            String userAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:124.0) Gecko/20100101 Firefox/124.0";
            String accept = "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8";
            Document doc = Jsoup.connect(url.toString())
                    .userAgent(userAgent)
                    .referrer("https://www.google.com")
                    .header("Accept", accept)
                    .header("Accept-Language", "en-US,en;q=0.9")
                    .timeout(15000)
                    .ignoreHttpErrors(true)
                    .get();
            
            doc = Jsoup.connect(url.toString())
                    .userAgent(userAgent)
                    .referrer("https://www.google.com")
                    .header("Accept", accept)
                    .header("Accept-Language", "en-US,en;q=0.9")
                    .timeout(15000)
                    .ignoreHttpErrors(true)
                    .get();
            
            
            // Sifra dijela
            Element partIdElement = doc.selectFirst("#content > div:nth-child(5) > div > div.pkw-product.ga-data > div > div.pkw-product__right > div.pkw-product__row.pkw-product__row--noflex > p.pkw-product__artikel");
//        Element partIdElement = doc.selectXpath("//*[@id=\"content\"]/div[5]/div/div[1]/div/div[2]/div[2]/p[1]").first();
            if(partIdElement == null) {
                continue;
            }
//        String code = partIdElement.text();
            code = partIdElement.text().split(": ")[1];
            
            // Naziv
            Element nameElement = doc.selectFirst("#content > div:nth-child(5) > div > div.pkw-product.ga-data > div > div.pkw-product__left > span > h1");
//        Element nameElement = doc.selectXpath("//*[@id=\"content\"]/div[5]/div/div[5]/div[1]/div/span/strong").first();
            if(nameElement == null) {
                continue;
            }
            name = (nameElement != null) ? nameElement.text() : "Not found";
            
            // Cijena
            Element priceElement = doc.selectFirst("#content > div:nth-child(5) > div > div.pkw-product.ga-data > div > div.pkw-product__right > div.pkw-product__row-price-block > div.pkw-product__row.pkw-product__row-wrap > div.pkw-product__rowspan.pkw-product__rowspan-price > p.pkw-product__price");
//        Element priceElement = doc.selectXpath("//*[@id=\"content\"]/div[5]/div/div[1]/div/div[2]/div[3]/div[1]/div[2]/p[1]").first();
            
//            double price = 0;
            if (priceElement != null) {
                price = priceElement.text().split(" ")[0].replace(",", ".");
            }
            
//         URL slike
//        Element imageDiv = doc.selectXpath("//*[@id=\"content\"]/div[5]/div/div[1]/div/div[1]/div/div[2]/div/ul/li[2]").first();
            Element imageDiv = doc.selectFirst("#content > div:nth-child(5) > div > div.pkw-product.ga-data > div > div.pkw-product__left > div > div.pkw-product__slider-image.bx-wrapper > div > ul > li:nth-child(2)");
            imageUrl = "Not found";
            if (imageDiv == null) {
                System.out.println("Slika pravi problem");
                continue;
                
            }
            Element img = imageDiv.selectFirst("img");
            if (img == null) {
                System.out.println("IMG pravi problem");
                continue;
                
            }
            imageUrl = img.absUrl("src");
            
            
        } while(code == null || name == null || price == null || imageUrl == null);
        return new Article(code, name, Double.parseDouble(price), imageUrl);
    }    

}