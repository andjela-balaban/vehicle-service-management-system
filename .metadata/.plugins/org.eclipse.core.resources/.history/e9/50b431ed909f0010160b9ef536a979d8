	@FXML
	private void openSupplierDialog() {
        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneChooseSupplier.fxml"));
            Parent root = loader.load();

            Stage dialogStage = new Stage();
            dialogStage.setTitle("Izbor dobavljača");
            dialogStage.initModality(Modality.WINDOW_MODAL);
            dialogStage.initOwner(buttonSupplierOrder.getScene().getWindow());
            dialogStage.setScene(new Scene(root));
            dialogStage.showAndWait();

        } catch (IOException ex) {
            ex.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", ex);
        }
    }
	
