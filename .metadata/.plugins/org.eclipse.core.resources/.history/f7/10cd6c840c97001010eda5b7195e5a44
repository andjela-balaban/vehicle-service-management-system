	private void handleRequest(String request, ObjectInputStream in, ObjectOutputStream out) throws IOException, ClassNotFoundException {
		switch (request) {
		case "offer_list": 
			
//			List<Item> items = new ArrayList<>();
//			items.add(new Item("1243", "kocnica", 12.0, new URL("https://translate.google.com/?hl=bs&sl=sr&tl=en&text=процесирај%20рачун%20&op=translate")));
//			items.add(new Item("321", "motor", 11.0, new URL("https://translate.google.com/?hl=bs&sl=sr&tl=en&text=процесирај%20рачун%20&op=translate")));
//			items.add(new Item("567", "svjecice", 14.0, new URL("https://translate.google.com/?hl=bs&sl=sr&tl=en&text=процесирај%20рачун%20&op=translate")));
//			out.writeObject(items);
			// Vracanje liste artikala centralnom serveru
			out.writeObject(itemService.getAllItems());
			out.flush();
			break;
		
		case "new_order": 
			// Primanje naruzdbe servisera, smjestanje u repository (i slanje u MQ)
			Order order = (Order) in.readObject();
			orderService.addOrder(order);
			int orderId = order.getId();

			// Vracanje id narudzbe centralnom serveru
			out.writeObject(orderId);
			out.flush();
			break;

		case "order_status": 
			// Primanje id naruzbe i vracanje statusa
			int id = (Integer) in.readObject();
			OrderStatus status = orderService.getOrderStatus(id);
			if(status == OrderStatus.APPROVED) {
				Receipt receipt = new Receipt(orderService.getOrderById(id));
				supplierService.processReceipt(receipt);
			}
			Order clientOrder = orderService.getOrderById(id);
			out.writeObject(clientOrder);
			out.flush();	
			break;
            
		default:
			System.out.println("Nepoznat zahtjev: " + request);
			break;
		}
	}
	
	
