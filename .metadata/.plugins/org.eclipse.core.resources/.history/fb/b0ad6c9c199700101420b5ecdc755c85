package org.unibl.etf.supplier.service;

import org.unibl.etf.model.Receipt;
import org.unibl.etf.model.Supplier;
import org.unibl.etf.properties.ConfigManager;
import org.unibl.etf.supplier.repository.SupplierRepository;
import java.rmi.registry.LocateRegistry;
import java.rmi.registry.Registry;
import org.unibl.etf.accounting.rmi.*;

public class SupplierService {

	private final SupplierRepository supplierRepository;
	
	public SupplierService() {
		supplierRepository = SupplierRepository.getInstance();
	}
	
	public Supplier findByName(String name) {
		return supplierRepository.getSuppliers().stream()
				.filter(s -> s.getName().equals(name))
				.findFirst()
				.orElse(null);
	}

	public void processReceipt(Receipt receipt) {
		try {
			String name = ConfigManager.ACCOUNTING_RMI;
			Registry registry = LocateRegistry.getRegistry(1099);
			AccountingInterface accounting = (AccountingInterface) registry.lookup(name);
			accounting.serializeReceipt(receipt);
		} catch(Exception e) {
			e.printStackTrace();
		}
	}
}
