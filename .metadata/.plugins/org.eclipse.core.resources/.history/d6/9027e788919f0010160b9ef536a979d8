package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import java.util.List;
import java.util.logging.Level;

import org.unibl.etf.model.Item;
import org.unibl.etf.model.Supplier;
import org.unibl.etf.service.rest.*;

import javafx.beans.property.SimpleDoubleProperty;
import javafx.beans.property.SimpleStringProperty;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Alert;
import javafx.scene.control.Button;
import javafx.scene.control.TableColumn;
import javafx.scene.control.TableView;
import javafx.stage.Modality;
import javafx.stage.Stage;

public class OrdersSceneController {

    @FXML
    private TableView<Item> itemsTable;
    @FXML
    private TableColumn<Item, String> colCode;
    @FXML
    private TableColumn<Item, String> colName;
    @FXML
    private TableColumn<Item, Double> colPrice;
    @FXML
    private TableColumn<Item, String> colImage;
    @FXML
    private Button back;
    @FXML
    private Button orderButton;
    @FXML
    private Button trackButton;

    private Supplier supplier;
    

    @FXML
    private void switchToMainScene() {
        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneMain.fxml"));
            Parent root = loader.load();
            Stage stage = (Stage) back.getScene().getWindow(); 
            Scene scene = new Scene(root);
            stage.setScene(scene);
            stage.setTitle("Main screen");
            stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

    public void setSupplier(Supplier supplier) {
        this.supplier = supplier;
        loadSupplierItems();
    }

    private void loadSupplierItems() {
        if (supplier == null) return;

        List<Item> items = SupplierRESTController.getSupplierItems(supplier.getName());
        if (items != null) {
            ObservableList<Item> observableItems = FXCollections.observableArrayList(items);
            itemsTable.setItems(observableItems);
        }
    }

    @FXML
    private void initialize() {
        colCode.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getCode()));
        colName.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getTitle()));
        colPrice.setCellValueFactory(c -> new SimpleDoubleProperty(c.getValue().getPrice()).asObject());
        colImage.setCellValueFactory(c -> new SimpleStringProperty(
            c.getValue().getImageURL() != null ? c.getValue().getImageURL().toString() : "-"));
    }
    

    // opening a dialog for entering the quantity in order to be able to order the item and create an order
    @FXML
    private void openOrderDialog() {
        Item selectedItem = itemsTable.getSelectionModel().getSelectedItem();
        if (selectedItem == null) {
            new Alert(Alert.AlertType.WARNING, "Please select an item before ordering.").showAndWait();
            return;
        }

        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneCreateOrderDialog.fxml"));
            Parent root = loader.load();

            CreateOrderDialogController controller = loader.getController();
            controller.setItem(supplier, selectedItem);

            Stage stage = new Stage();
            stage.setScene(new Scene(root));
            stage.initModality(Modality.APPLICATION_MODAL);
            stage.showAndWait();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
    
    @FXML
    private void openSendOrderDialog() {
        Item selectedItem = itemsTable.getSelectionModel().getSelectedItem();
        if (selectedItem == null) {
            new Alert(Alert.AlertType.ERROR, "Izaberite artikl za naručivanje.").showAndWait();
            return;
        }

        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneCreateOrderDialog.fxml"));
            Parent root = loader.load();

            CreateOrderDialogController dialogController = loader.getController();
            dialogController.setItem(supplier, selectedItem);

            Stage stage = new Stage();
            stage.setScene(new Scene(root));
            stage.setTitle("Slanje narudžbe");
            stage.initModality(Modality.APPLICATION_MODAL);
            stage.showAndWait();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

    @FXML
    private void openOrderStatusDialog() {
        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneTrackOrder.fxml"));
            Parent root = loader.load();

            Stage stage = new Stage();
            stage.setScene(new Scene(root));
            stage.setTitle("Status narudžbe");
            stage.initModality(Modality.APPLICATION_MODAL);
            stage.showAndWait();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

}
