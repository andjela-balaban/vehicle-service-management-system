package org.unibl.etf.supplier.server;

import org.unibl.etf.model.Supplier;
import org.unibl.etf.properties.ConfigManager;
import org.unibl.etf.supplier.service.*;
import java.io.*;
import javax.net.ssl.*;
import javax.net.ssl.SSLServerSocket;
import javax.net.ssl.SSLServerSocketFactory;

public class SupplierServer {
	private static String KEY_STORE_PATH = ConfigManager.KEY_STORE_PATH;
	private static String KEY_STORE_PASSWORD = ConfigManager.KEY_STORE_PASSWORD;

	private static Supplier supplier;
	private static int port;
	
	public SupplierServer(String name) {
		loadProperties(name);
	}
	
	private static void loadProperties(String name) {
		SupplierService service = new SupplierService();
		supplier = service.findByName(name);
		if(supplier != null) {
			port = supplier.getPort();
		}
	}
	
	public void start() throws IOException {
		
        if (supplier == null) {
            System.out.println("Dobavljač nije pronađen.");
            return;
        }
        System.setProperty("javax.net.ssl.keyStore", KEY_STORE_PATH);
        System.setProperty("javax.net.ssl.keyStorePassword", KEY_STORE_PASSWORD);

        SSLServerSocketFactory ssf = (SSLServerSocketFactory) SSLServerSocketFactory.getDefault();
        SSLServerSocket ss = (SSLServerSocket) ssf.createServerSocket(port);
        
        System.out.println("Server dobavljaca '" + supplier.getName() + "' pokrenut na portu " + port);

        while (true) {
        	SSLSocket clientSocket = (SSLSocket) ss.accept();
        	System.out.println("Povezan servis sa: " + clientSocket.getInetAddress());

        	// Novi thread za komunikaciju sa servisom
        	new SupplierHandlerThread(clientSocket, supplier).start();
        }
    }



}
