	@Override
	public void run() {
		try {
			String request;
			while ((request = (String) in.readObject()) != null) {
				System.out.println("Primljeno od servisera: " + request);

				switch (request) {
				case "offer_list": 
					// Vracanje liste artikala centralnom serveru
					out.writeObject(itemService.getAllItems());
					out.flush();
					break;
				
				case "new_order": 
					// Primanje naruzdbe servisera, smjestanje u repository (i slanje u MQ)
					Order order = (Order) in.readObject();
					orderService.addOrder(order);
					int orderId = order.getId();

					// Vracanje id narudzbe centralnom serveru
					out.writeObject(orderId);
					out.flush();
					break;

				case "order_status": 
					// Primanje id naruzbe i vracanje statusa
					int id = (Integer) in.readObject();
					OrderStatus status = orderService.getOrderStatus(id);
					
					out.writeObject(status);
					out.flush();	
					break;
                    
				default:
					System.out.println("Nepoznat zahtjev: " + request);
					break;
				}
            }
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
        	try {
            	in.close();
            	out.close();
				socket.close();
			} catch (IOException e) {
				e.printStackTrace();
			}
        }
    }

	
	
	
	
