package application;

import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.*;
import javafx.stage.Stage;
import javafx.application.Platform;

import java.io.IOException;
import java.util.List;

import org.unibl.etf.chat.client.ChatClient;
import org.unibl.etf.client.chat.UserRegistry;
import org.unibl.etf.dto.ChatMessage;
import org.unibl.etf.dto.MessageListener;
import org.unibl.etf.dto.MessageType;
import org.unibl.etf.session.UserSession;

public class ChatSceneController {

    @FXML 
    private ListView<String> usersListView;
    @FXML 
    private ListView<String> groupsListView;
    @FXML 
    private ListView<String> chatMessagesListView;
    @FXML 
    private TextField messageField;
    @FXML 
    private Button sendButton;
    @FXML
	private Button back;
	
    private ChatClient chatClient;
    private UserRegistry userRegistry;
	
    
	@FXML
    private void switchToMainScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneMain.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) back.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Main screen");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

	

	public void initialize() {
	    userRegistry = new UserRegistry();

	    // Pretpostavimo da ovo dobijemo iz servera ili REST-a: lista aktivnih ID-eva
	    List<Integer> activeUserIds = List.of(1, 2, 3); // primjer
	    for (Integer id : activeUserIds) {
	        userRegistry.addUser(id, "Korisnik " + id);
	    }

	    // Popuni ListView
	    usersListView.getItems().clear();
	    usersListView.getItems().addAll(userRegistry.getAllUsernames());
	    groupsListView.getItems().addAll("Dijelovi i tako to");

	    // Poveži chat client
	    chatClient = new ChatClient();
	    try {
	        chatClient.setMessageListener(new MessageListener() {
	            @Override
	            public void onMessage(ChatMessage msg) {
	                Platform.runLater(() -> chatMessagesListView.getItems().add(
	                    "[Od " + userRegistry.getUsername(msg.getSenderId()) + "] " + msg.getContent()));
	            }

	            @Override
	            public void onMulticast(String msg) {
	            	String groupName = msg.split("#")[1];
	            	String message = msg.split("#")[2];
	                Platform.runLater(() -> chatMessagesListView.getItems().add("[Grupa " + groupName + "]: " + message));
	            }
	        });

	        chatClient.connect(UserSession.getInstance().getClientId());
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	}


	@FXML
	private void handleSend() {
	    String text = messageField.getText();
	    String receiverUsername = usersListView.getSelectionModel().getSelectedItem();
	    String group = groupsListView.getSelectionModel().getSelectedItem();

	    if (text.isEmpty()) return;

	    try {
	        ChatMessage msg = new ChatMessage();
	        msg.setSenderId(UserSession.getInstance().getClientId());
	        msg.setContent(text);

	        if (receiverUsername != null) {
	            // Unicast
	            int receiverId = userRegistry.getId(receiverUsername);
	            msg.setReceiverId(String.valueOf(receiverId));
	            msg.setType(MessageType.UNICAST);
	            chatClient.sendMessage(msg);
	            chatMessagesListView.getItems().add("[Ja -> " + receiverUsername + "] " + text);

	        } else if (group != null) {
	            // Multicast
	            msg.setReceiverId(group);
	            msg.setType(MessageType.MULTICAST);
	            chatClient.sendMessage(msg);
	            chatMessagesListView.getItems().add("[Ja -> " + group + "] " + text);
	        } else {
	            chatMessagesListView.getItems().add("[Sistem] Odaberi korisnika ili grupu.");
	        }

	        messageField.clear();
	    } catch (Exception e) {
	        e.printStackTrace();
	    }
	}

}

