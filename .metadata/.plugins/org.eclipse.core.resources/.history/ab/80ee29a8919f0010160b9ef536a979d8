package application;

import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.control.TextArea;
import javafx.scene.control.TextField;
import javafx.scene.control.*;
import javafx.stage.Stage;
import org.unibl.etf.model.VehiclePart;
import org.unibl.etf.service.rest.PartRESTController;

public class PartDialogSceneController {

    @FXML 
    private TextField codeField;
    @FXML 
    private TextField nameField;
    @FXML 
    private TextField manufacturerField;
    @FXML 
    private TextField priceField;
    @FXML 
    private TextField availableQuantityField;
    @FXML 
    private TextArea descriptionArea;
    @FXML 
    private Button confirmButton;
    @FXML 
    private Button cancelButton;

    private VehiclePart part;

    public void setPart(VehiclePart part) {
        this.part = part;
        if (part != null) { // edit
            codeField.setText(part.getCode());
            codeField.setEditable(false);
            nameField.setText(part.getName());
            manufacturerField.setText(part.getManufacturer());
            priceField.setText(String.valueOf(part.getPrice()));
            availableQuantityField.setText(String.valueOf(part.getAvailableQuantity()));
            descriptionArea.setText(part.getDescription());
        }
    }

    @FXML
    private void initialize() {
        confirmButton.setOnAction(e -> saveAndClose());
        cancelButton.setOnAction(e -> closeDialog());
    }

    private void saveAndClose() {
        try {
            String code = codeField.getText();
            String name = nameField.getText();
            String manufacturer = manufacturerField.getText();
            double price = Double.parseDouble(priceField.getText());
            int availableQuantity = Integer.parseInt(availableQuantityField.getText());
            String description = descriptionArea.getText();

            VehiclePart newPart = new VehiclePart(code, name, manufacturer, price, availableQuantity, description);

            boolean success;
            if (part == null) {
                success = PartRESTController.createPart(newPart);
            } else {
                success = PartRESTController.updatePart(code, newPart);
            }

            if (success) {
                Stage stage = (Stage) confirmButton.getScene().getWindow();
                stage.close();
            } else {
                new Alert(Alert.AlertType.ERROR, "The operation failed.").showAndWait();
            }
        } catch (NumberFormatException ex) {
            new Alert(Alert.AlertType.ERROR, "Neispravan unos za cijenu ili količinu.").showAndWait();
        }
    }

    private void closeDialog() {
        Stage stage = (Stage) cancelButton.getScene().getWindow();
        stage.close();
    }
}
