package application;

import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.collections.FXCollections;
import javafx.scene.control.*;

import org.unibl.etf.dto.OrderRequestDTO;
import org.unibl.etf.model.Item;
import org.unibl.etf.model.Order;
import org.unibl.etf.model.Supplier;
import org.unibl.etf.service.rest.SupplierRESTController;

import java.util.List;

public class TrackOrderSceneController {
    @FXML 
    private ChoiceBox<Supplier> supplierChoice;
    @FXML 
    private ChoiceBox<Item> itemChoice;
    @FXML 
    private TextField statusField;
    @FXML 
    private Button confirmButton;

    @FXML
    private void initialize() {
    	statusField.setEditable(false);
        supplierChoice.setItems(FXCollections.observableArrayList(SupplierRESTController.getAllSuppliers()));
        supplierChoice.getSelectionModel().selectedItemProperty().addListener((obs, oldVal, newVal) -> {
            if (newVal != null) {
                List<Item> items = SupplierRESTController.getSupplierItems(newVal.getName());
                itemChoice.setItems(FXCollections.observableArrayList(items));
            }
        });
        confirmButton.setOnAction(e -> checkStatus());
    }

    private void checkStatus() {
        Supplier supplier = supplierChoice.getValue();
        Item item = itemChoice.getValue();

        if (supplier == null || item == null) {
            new Alert(Alert.AlertType.ERROR, "Select supplier and item").showAndWait();
            return;
        }

        // Retrieve all orders from that supplier
        List<OrderRequestDTO> orders = SupplierRESTController.getAllOrders(supplier.getName());

        if (orders == null || orders.isEmpty()) {
            statusField.setText("Nema narudžbi za ovog dobavljača");
            return;
        }

        // Nalazenje narudzbe za izabrani artikl
        OrderRequestDTO match = orders.stream()
                .filter(o -> o.getItem().getCode().equals(item.getCode()))
                .findFirst()
                .orElse(null);

        if (match == null) {
            statusField.setText("Nema narudžbe za dati artikl");
            return;
        }

        // Dobijanje statusa narudzbe
        Order order = SupplierRESTController.getOrder(supplier.getName(), match.getId());
        if (order != null) {
            statusField.setText(order.getStatus().toString());
        } else {
            statusField.setText("Greška pri dohvatanju statusa");
        }
    }

}
