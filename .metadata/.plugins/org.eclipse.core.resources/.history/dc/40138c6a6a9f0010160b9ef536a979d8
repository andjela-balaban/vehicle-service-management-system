package org.unibl.etf.central.server.supplier;

import static org.unibl.etf.logger.MyLogger.logger;

import java.util.*;
import java.util.logging.Level;

import org.unibl.etf.model.*;
import org.unibl.etf.central.server.service.*;

public class SupplierClientTest {
    public static void main(String[] args) {
        try {
            SupplierService service = new SupplierService();
            Supplier supplier = service.findByName("supplier1");

            SupplierClient client = new SupplierClient();

            // Getting an offer
            List<Item> items = client.getOffer(supplier);
            System.out.println("The supplier has the following items:");
            for (Item item : items) {
                System.out.println("\t" + item.getCode() + " - " + item.getTitle() + " - " + item.getPrice());
            }

            // Making an order
            Item item = items.get(0);
            int orderId = client.sendOrder(supplier, item, 2);
            System.out.println("Order sent, ID: " + orderId);

            // Provjeri status narudzbe
            Order order = client.getOrderStatus(supplier, orderId);
            System.out.println("Status narudzbe: " + order.getStatus());

        } catch (Exception e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
}
