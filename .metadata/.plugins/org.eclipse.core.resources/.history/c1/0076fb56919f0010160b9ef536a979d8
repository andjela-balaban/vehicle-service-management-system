package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.stage.Stage;
import javafx.collections.FXCollections;
import javafx.collections.ObservableList;
import javafx.scene.control.*;
import javafx.stage.Modality;
import org.unibl.etf.model.VehiclePart;
import org.unibl.etf.service.rest.PartRESTController;
import java.util.List;
import java.util.logging.Level;

public class ManagePartsSceneController {

    @FXML 
    private TableView<VehiclePart> partsTable;
    @FXML 
    private TableColumn<VehiclePart, String> codeCol;
    @FXML 
    private TableColumn<VehiclePart, String> nameCol;
    @FXML 
    private TableColumn<VehiclePart, String> manufacturerCol;
    @FXML 
    private TableColumn<VehiclePart, Double> priceCol;
    @FXML 
    private TableColumn<VehiclePart, Integer> quantityCol;
    @FXML 
    private TableColumn<VehiclePart, String> descriptionCol;

    @FXML 
    private Button addButton;
    @FXML 
    private Button deleteButton;
    @FXML 
    private Button editButton;
    @FXML 
    private Button back;
    private ObservableList<VehiclePart> partsObservableList = FXCollections.observableArrayList();


    @FXML
    private void switchToMainScene() {
        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneMain.fxml"));
            Parent root = loader.load();
            Stage stage = (Stage) back.getScene().getWindow();

            Scene scene = new Scene(root);
            stage.setScene(scene);
            stage.setTitle("Main screen");
            stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }

    @FXML
    public void initialize() {
        // column mapping
        codeCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleStringProperty(cell.getValue().getCode()));
        nameCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleStringProperty(cell.getValue().getName()));
        manufacturerCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleStringProperty(cell.getValue().getManufacturer()));
        priceCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleObjectProperty<>(cell.getValue().getPrice()));
        quantityCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleObjectProperty<>(cell.getValue().getAvailableQuantity()));
        descriptionCol.setCellValueFactory(cell -> new javafx.beans.property.SimpleStringProperty(cell.getValue().getDescription()));

        partsTable.setItems(partsObservableList);
        refreshParts();

        // add part
        addButton.setOnAction(e -> {
			try {
				openDialog(null, "Add new part");
			} catch (IOException e1) {
				e1.printStackTrace();
				logger.log(Level.WARNING, "Exception: ", e1);
			}
		});

        // edit part
        editButton.setOnAction(e -> {
            VehiclePart selected = partsTable.getSelectionModel().getSelectedItem();
            if (selected != null) {
                try {
					openDialog(selected, "Izmijeni dio");
				} catch (IOException e1) {
					e1.printStackTrace();
					logger.log(Level.WARNING, "Exception: ", e1);
				}
            } else {
                new Alert(Alert.AlertType.WARNING, "Morate odabrati dio za izmjenu.").showAndWait();
            }
        });

        // delete
        deleteButton.setOnAction(e -> {
            VehiclePart selected = partsTable.getSelectionModel().getSelectedItem();
            if (selected != null) {
                boolean deleted = PartRESTController.deletePart(selected.getCode());
                if (deleted) {
                    refreshParts();
                } else {
                    new Alert(Alert.AlertType.ERROR, "Brisanje nije uspjelo.").showAndWait();
                }
            } else {
                new Alert(Alert.AlertType.WARNING, "Morate odabrati dio za brisanje.").showAndWait();
            }
        });
    }

    private void refreshParts() {
        List<VehiclePart> parts = PartRESTController.getAllParts();
        if (parts != null) {
            partsObservableList.setAll(parts);
        }
    }

    private void openDialog(VehiclePart part, String title) throws IOException {
        FXMLLoader loader = new FXMLLoader(getClass().getResource("ScenePartDialog.fxml"));
        System.out.println(getClass().getResource("PartDialogScene.fxml"));
        Parent root = loader.load();

        PartDialogSceneController controller = loader.getController();
        controller.setPart(part);

        Stage dialogStage = new Stage();
        dialogStage.setTitle(title);
        dialogStage.initModality(Modality.WINDOW_MODAL);
        dialogStage.initOwner(partsTable.getScene().getWindow());
        dialogStage.setScene(new Scene(root));
        dialogStage.showAndWait();

        refreshParts();
    }

}
