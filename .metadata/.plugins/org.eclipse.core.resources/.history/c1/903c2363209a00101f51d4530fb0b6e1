package org.unibl.etf.supplierapp.server;

import javax.net.ssl.SSLSocket;
import javax.net.ssl.SSLSocketFactory;
import java.util.*;
import java.io.*;
import org.unibl.etf.properties.ConfigManager;
import org.unibl.etf.model.*;


public class SupplierGUIClient {

    private static String KEY_STORE_PATH = ConfigManager.KEY_STORE_PATH;
    private static String KEY_STORE_PASSWORD = ConfigManager.KEY_STORE_PASSWORD;

    private String host;
    private Supplier supplier;
    private int port;

    public SupplierGUIClient(String host, int port) {
        this.host = host;
        this.port = port;
    }

    private SSLSocket createSocket() throws Exception {
        System.setProperty("javax.net.ssl.trustStore", KEY_STORE_PATH);
        System.setProperty("javax.net.ssl.trustStorePassword", KEY_STORE_PASSWORD);

        SSLSocketFactory sf = (SSLSocketFactory) SSLSocketFactory.getDefault();
        return (SSLSocket) sf.createSocket(host, port);
    }

    public boolean login(String name) throws Exception {
        try (SSLSocket socket = createSocket();
             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {

            out.writeObject("login");
            out.flush();

            out.writeObject(name);
            out.flush();

            String response = (String) in.readObject();
            if("OK".equals(response)) {
            	this.supplier = (Supplier) in.readObject();
            	return true;
            }
            return false;
        }
    }

    @SuppressWarnings("unchecked")
	public List<Item> getItems() throws Exception {
        try (SSLSocket socket = createSocket();
             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {

            out.writeObject("items_list");
            out.flush();

            return (List<Item>) in.readObject();
        }
    }

    public boolean addItem(Item item) throws Exception {
        try (SSLSocket socket = createSocket();
             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {

            out.writeObject("add_item");
            out.flush();

            out.writeObject(item);
            out.flush();

            String result = (String) in.readObject();
            return "OK".equals(result);
        }
    }

    public Order getNextOrder() throws Exception {
        try (SSLSocket socket = createSocket();
             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {

            out.writeObject("approve_next");
            out.flush();

            return (Order) in.readObject();
        }
    }

    public boolean approveOrder(int orderId) throws Exception {
        return updateOrderStatus("approve", orderId);
    }

    public boolean rejectOrder(int orderId) throws Exception {
        return updateOrderStatus("reject", orderId);
    }

    private boolean updateOrderStatus(String action, int orderId) throws Exception {
        try (SSLSocket socket = createSocket();
             ObjectOutputStream out = new ObjectOutputStream(socket.getOutputStream());
             ObjectInputStream in = new ObjectInputStream(socket.getInputStream())) {

            out.writeObject(action);
            out.flush();

            out.writeObject(orderId);
            out.flush();

            String response = (String) in.readObject();
            return "OK".equals(response);
        }
    }
    
    public Supplier getSupplier() {
    	return supplier;
    }
}
