package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import org.unibl.etf.model.Appointment;
import org.unibl.etf.session.UserSession;
import java.time.*;
import java.time.format.DateTimeFormatter;
import java.util.*;
import java.util.logging.Level;

import org.unibl.etf.client.rest.AppointmentsHistoryRESTController;
import javafx.beans.property.SimpleStringProperty;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.TableColumn;
import javafx.scene.control.TableView;
import javafx.stage.Stage;

public class AppointmentsHistoryController {
	@FXML
	private Button back;
	@FXML
    private TableView<Appointment> appointmentsTable;
    @FXML
    private TableColumn<Appointment, String> colTermin;
    @FXML
    private TableColumn<Appointment, String> colUsluga;
    @FXML
    private TableColumn<Appointment, String> colStatus;
    @FXML
    private TableColumn<Appointment, String> colOpis;
	
	
	@FXML
    private void switchToMainScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneMain.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) back.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Main screen");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
	
	@FXML
    private void initialize() {
        // Appointment = date + time
		DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd.MM.yyyy   HH:mm");

	    // Appointment = date + time formatted
	    colTermin.setCellValueFactory(cellData -> {
	        LocalDate date = cellData.getValue().getDate();
	        LocalTime time = cellData.getValue().getTime();

	        if (date != null && time != null) {
	            LocalDateTime dateTime = LocalDateTime.of(date, time);
	            return new SimpleStringProperty(dateTime.format(formatter));
	        } else {
	            return new SimpleStringProperty("");
	        }
	    });

        // Usluga
        colUsluga.setCellValueFactory(cellData ->
            new SimpleStringProperty(
                cellData.getValue().getServiceType() != null ?
                cellData.getValue().getServiceType().toString() : ""
            )
        );

        // Status
        colStatus.setCellValueFactory(cellData ->
            new SimpleStringProperty(
                cellData.getValue().getStatus() != null ?
                cellData.getValue().getStatus().toString() : ""
            )
        );

        // Opis (comment)
        colOpis.setCellValueFactory(cellData ->
            new SimpleStringProperty(
                cellData.getValue().getComment() != null ?
                cellData.getValue().getComment() : ""
            )
        );
        int clientId = UserSession.getInstance().getClientId();
        // Hardkodiran clientId = 1 (ovo možeš kasnije da primaš iz glavnog prozora)
        List<Appointment> appointments = AppointmentsHistoryRESTController.getHistoryAppointments(clientId);

        if (appointments != null) {
            appointmentsTable.getItems().setAll(appointments);
        }
    }
	
	
}
