package org.unibl.etf.supplier.service;

import java.util.List;
import org.unibl.etf.model.*;
import org.unibl.etf.mq.sender.OrderProducer;
import org.unibl.etf.supplier.repository.*;

public class OrderService {
private final OrderRepository orderRepository;
	
	public OrderService() {
		orderRepository = OrderRepository.getInstance();
	}
	
	public List<Order> getAllOrders(){
		return orderRepository.getOrders();
	}
	
	public Order getOrderById(int id) {
		for(Order order : orderRepository.getOrders()) {
			if(order.getId() == id)
				return order;
		}
		return null;
	}
	
	public OrderStatus getOrderStatus(int id) {
		Order order = getOrderById(id);
		if(order != null)
			return order.getStatus();
		return null;
	}
	
	public boolean addOrder(Order order) {
		boolean added = orderRepository.addOrder(order);
		if(added) {
			// slanje narudzbe u MQ
			try {
				OrderProducer.sendOrder(order);
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
		return added;
	}
	
	public boolean removeOrder(Order order) {
		return orderRepository.removeOrder(order);
	}
	
	public void updateOrderStatus(int orderId, OrderStatus status) {
		Order order = getOrderById(orderId);
		if(order != null)
			order.setStatus(status);
	}
}
