package org.unibl.etf.service.rest;

import org.unibl.etf.dto.OrderRequestDTO;
import org.unibl.etf.model.Item;
import org.unibl.etf.model.Order;
import org.unibl.etf.model.Supplier;
import org.unibl.etf.properties.ConfigManager;
import javax.ws.rs.client.Client;
import javax.ws.rs.client.ClientBuilder;
import javax.ws.rs.client.Entity;
import javax.ws.rs.client.WebTarget;
import javax.ws.rs.core.MediaType;
import javax.ws.rs.core.Response;
import java.util.List;

public class SupplierRESTController {

	private static String BASE_URL = ConfigManager.SUPPLIERS_URL;
			
	public static List<Supplier> getAllSuppliers(){
		Client client = ClientBuilder.newClient();
		WebTarget target = client.target(BASE_URL);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			List<Supplier> suppliers = response.readEntity(new javax.ws.rs.core.GenericType<List<Supplier>>() {});
			return suppliers;
		}
		return null;
	}
	
	
	public Supplier getSupplierByName(String name) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name;
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			Supplier supplier = response.readEntity(Supplier.class);
			return supplier;
		}
		return null;
	}
	
	public static List<Item> getSupplierItems(String name){
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name + "/items";
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			List<Item> items = response.readEntity(new javax.ws.rs.core.GenericType<List<Item>>() {});
			return items;
		}
		return null;
	}
			
	public Item getItemFromSupplier(String name, String itemCode) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name + "/items/" + itemCode;
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			Item item = response.readEntity(Item.class);
			client.close();
			return item;
		}
		client.close();
		return null;
	}
	
	
	public static Order getOrder(String name, int orderId) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name + "/orders/" + orderId;
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			Order order = response.readEntity(Order.class);
			client.close();
			return order;
		}
		client.close();
		return null;
	}
	
	public static int sendOrder(String name, int quantity, Item item) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name + "/send/" + quantity;
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).post(Entity.entity(item, MediaType.APPLICATION_JSON));
		
		if(response.getStatus() == 200) {
			int orderId = response.readEntity(Integer.class);
			client.close();
			return orderId;
		}
		client.close();
		return -1;
	}
	
	public static List<OrderRequestDTO> getAllOrders(String name) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + name + "/orders";
		WebTarget target = client.target(url);
		
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			List<OrderRequestDTO> orders = response.readEntity(new javax.ws.rs.core.GenericType<List<OrderRequestDTO>>() {});
			client.close();		
			return orders;
		}
		client.close();		
		return null;
	}
}
