    @FXML
    private void openAddItemDialog() {
        try {
            FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneAddItem.fxml"));
            Parent root = loader.load();

            AddItemDialogController dialogController = loader.getController();
            dialogController.setClientAndParent(client, this);

            Stage stage = new Stage();
            stage.setScene(new Scene(root));
            stage.setTitle("Dodavanje novog artikla");
            stage.initModality(Modality.APPLICATION_MODAL);
            stage.showAndWait();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

