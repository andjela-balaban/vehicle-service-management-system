    @FXML
    private void initialize() {
        this.client = LoginSceneController.getSupplierClient();

        colCode.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getCode()));
        colName.setCellValueFactory(c -> new SimpleStringProperty(c.getValue().getTitle()));
        colPrice.setCellValueFactory(c -> new SimpleDoubleProperty(c.getValue().getPrice()).asObject());
        colImage.setCellValueFactory(c -> new SimpleStringProperty(
            c.getValue().getImageURL() != null ? c.getValue().getImageURL().toString() : "-"));

        // Dodaj ovo da se tabela odmah popuni
        loadSupplierItems();
    }


    
