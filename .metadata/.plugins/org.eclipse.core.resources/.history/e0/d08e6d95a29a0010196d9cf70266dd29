package org.unibl.etf.service.rest;

import java.util.*;
import javax.ws.rs.client.Client;
import javax.ws.rs.client.ClientBuilder;
import javax.ws.rs.client.Entity;
import javax.ws.rs.client.WebTarget;
import javax.ws.rs.core.MediaType;
import javax.ws.rs.core.Response;

import org.unibl.etf.properties.ConfigManager;


public class ClientRESTController {

	private static String BASE_URL = ConfigManager.CLIENTS_URL;
	
	public static List<org.unibl.etf.model.Client> getAllClients() {
        Client client = ClientBuilder.newClient();
        WebTarget target = client.target(BASE_URL);

        Response response = target.request(MediaType.APPLICATION_JSON).get();
        
        if (response.getStatus() == 200) {
            List<org.unibl.etf.model.Client> clients = response.readEntity(
                new javax.ws.rs.core.GenericType<List<org.unibl.etf.model.Client>>() {}
            );
            return clients;
        } else {
            System.out.println("Error: " + response.getStatus());
            return new ArrayList<>();
        }
    }
	
	public static org.unibl.etf.model.Client getClientByUsername(String username){
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/by-username/" + username;
		WebTarget target = client.target(url);
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			org.unibl.etf.model.Client clientRes = response.readEntity(org.unibl.etf.model.Client.class);
			client.close();
			return clientRes;
		}
		client.close();
		return null;
	}
	
	public static org.unibl.etf.model.Client getClientById(int id){
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + id;
		WebTarget target = client.target(url);
		Response response = target.request(MediaType.APPLICATION_JSON).get();
		
		if(response.getStatus() == 200) {
			org.unibl.etf.model.Client clientRes = response.readEntity(org.unibl.etf.model.Client.class);
			client.close();
			return clientRes;
		}
		client.close();
		return null;
	}
	
	public static boolean approveClientAccount(int id) {
		Client client = ClientBuilder.newClient();
		String url = ConfigManager.APPROVE_ACCOUNT_URL;
		url = url.replace("{id}", id + "");
		WebTarget target = client.target(url);
		Response response = target.request(MediaType.APPLICATION_JSON).put(Entity.text(""));
		
		if(response.getStatus() == 200) {
			client.close();
			return true;
		}
		client.close();
		return false;
	}
	
	public static boolean blockClientAccount(int id) {
		Client client = ClientBuilder.newClient();
		String url = ConfigManager.BLOCK_ACCOUNT_URL;
		url = url.replace("{id}", id + "");
		WebTarget target = client.target(url);
		Response response = target.request(MediaType.APPLICATION_JSON).put(Entity.text(""));
		
		if(response.getStatus() == 200) {
			client.close();
			return true;
		}
		client.close();
		return false;
	}
	
	public static boolean removeClient(int id) {
		Client client = ClientBuilder.newClient();
		String url = BASE_URL + "/" + id;
		WebTarget target = client.target(url);
		Response response = target.request(MediaType.APPLICATION_JSON).delete();
		
		if(response.getStatus() == 200) {
			client.close();			
			return true;
		}
		client.close();
		return false;
	}
}
