package org.unibl.etf.supplier.repository;

import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;
import java.util.*;
import org.unibl.etf.model.*;
import org.unibl.etf.properties.ConfigManager;

public class ItemRepository {
	private List<Item> items = new ArrayList<>();
	private static ItemRepository instance = null;
	private static String LINKS_PATH = ConfigManager.LINKS_PATH;
	
	private ItemRepository() {
		super();
		loadItems();
	}
	
	//TODO - ucitavanje artikala pomocu parsera
	private static void loadItems() {
		try(BufferedReader in = new BufferedReader(new FileReader(LINKS_PATH))){
			 String line;
			 while((line = in.readLine()) != null) {
				 String parts[] = line.split("#");
				 if(parts.length == 3) {
					 String name = parts[0];
					 String host = parts[1];
					 int port = Integer.parseInt(parts[2]);
					 suppliers.add(new Supplier(name, host, port));
				 }
			 }
		} catch(IOException e) {
			e.printStackTrace();
		}
	}
	
	public static ItemRepository getInstance() {
		 if(instance == null) 
			 instance = new ItemRepository();
		 return instance; 
	}
	
	public List<Item> getItems(){
		return items;
	}
}
