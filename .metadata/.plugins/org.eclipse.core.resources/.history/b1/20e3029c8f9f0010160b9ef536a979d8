package application;

import static org.unibl.etf.logger.MyLogger.logger;

import java.io.IOException;
import java.util.logging.Level;

import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.image.ImageView;
import javafx.stage.Stage;

public class MainSceneController {
	@FXML
	private Button buttonItems;
	@FXML
	private Button buttonOrders;
	@FXML
	private ImageView logoutImage;
	
	
	@FXML
    private void switchToItemsScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneItems.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) buttonItems.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Artikli");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
	
	@FXML
    private void switchToOrdersScene() {
        try {
        	FXMLLoader loader = new FXMLLoader(getClass().getResource("SceneOrders.fxml"));
        	Parent root = loader.load();
        	Stage stage = (Stage) buttonOrders.getScene().getWindow();
        	
        	Scene scene = new Scene(root);
        	stage.setScene(scene);
        	stage.setTitle("Narudžbe");
        	stage.show();
        } catch (IOException e) {
            e.printStackTrace();
            logger.log(Level.WARNING, "Exception: ", e);
        }
    }
	
	@FXML
	private void handleLogout() {
	    javafx.application.Platform.exit();
	    System.exit(0);
	}
}
