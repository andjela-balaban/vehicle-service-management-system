package org.unibl.etf.central.server.email;

import jakarta.mail.*;
import jakarta.mail.internet.*;
import java.io.File;
import java.util.Properties;
import org.unibl.etf.properties.ConfigManager;

public class EmailSender {
	private static final String EMAIL_FROM = ConfigManager.EMAIL_FROM;
	private static final String APP_PASSWORD = ConfigManager.APP_PASSWORD;

    public static void sendEmail(String emailTo, String fileName) throws Exception {
        Message message = new MimeMessage(getEmailSession());
        message.setFrom(new InternetAddress(EMAIL_FROM));
        message.setRecipients(Message.RecipientType.TO, InternetAddress.parse(emailTo));
        message.setSubject("Invoice Attached");

        MimeBodyPart textPart = new MimeBodyPart();
        textPart.setText("Dear Customer,\n\nPlease find attached the invoice in ZIP format. Thank you for choosing our services.\n\nSincerely,\nService team");
        // attachment (ZIP file)
        MimeBodyPart attachmentPart = new MimeBodyPart();
        File file = new File(fileName); 
        attachmentPart.attachFile(file);
        // kombinovanje u Multipart - text + attachment
        Multipart multipart = new MimeMultipart();
        multipart.addBodyPart(textPart);
        multipart.addBodyPart(attachmentPart);

        message.setContent(multipart);
        // slanje poruke
        Transport.send(message);	

        System.out.println("Email sa prilogom je poslat!");
    }

    private static Session getEmailSession() {
        return Session.getInstance(getGmailProperties(), new Authenticator() {
            protected PasswordAuthentication getPasswordAuthentication() {
                return new PasswordAuthentication(EMAIL_FROM, APP_PASSWORD);
            }
        });
    }

    private static Properties getGmailProperties() {
        Properties prop = new Properties();
        prop.put("mail.smtp.auth", "true");
        prop.put("mail.smtp.starttls.enable", "true");
        prop.put("mail.smtp.host", "smtp.gmail.com");
        prop.put("mail.smtp.port", "587");
        prop.put("mail.smtp.ssl.trust", "smtp.gmail.com");
        return prop;
    }
}
